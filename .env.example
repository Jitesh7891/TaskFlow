# Environment
NODE_ENV=development
PORT=3000

# MongoDB
# Direct local development (with MongoDB exposed on your machine)
# Remote: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Redis
# Direct local development (with Redis exposed on your machine)
# Remote: redis://default:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (optional — omit for open access, set to restrict to a specific frontend)
# CORS_ORIGIN=https://your-frontend.com
