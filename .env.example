# Environment
NODE_ENV=development
PORT=3000

# MongoDB
# Local Docker: mongodb://mongo:27017/taskflow (use as is for local dev!)
# Remote: mongodb+srv://...
MONGODB_URI=mongodb://mongo:27017/taskflow

# Redis
# Local Docker: redis://redis:6379 (use as is for local dev!)
# Remote: redis://default:password@host:port
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (optional — omit for open access, set to restrict to a specific frontend)
# CORS_ORIGIN=https://your-frontend.com
